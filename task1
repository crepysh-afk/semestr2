#include <iostream>
#include <cmath>

using namespace std;

class Cone {
private:
    double x, y, z;
    double radius;
    double height;

public:
    Cone(double cx, double cy, double cz, double r, double h) {
        x = cx;
        y = cy;
        z = cz;
        radius = r;
        height = h;
    }

    double slantHeight() const {
        return sqrt(radius * radius + height * height);
    }

    double surfaceArea() const {
        double l = slantHeight();
        return 3.141592653589793 * radius * (radius + l);
    }

    void print() const {
        cout << "Center: (" << x << ", " << y << ", " << z << ")" << endl;
        cout << "Radius: " << radius << endl;
        cout << "Height: " << height << endl;
        cout << "Surface Area: " << surfaceArea() << endl;
    }
};

int main() {
    Cone cone(0, 0, 0, 5, 12);
    cone.print();
    return 0;
}
